{
  "name": "ready-mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Ready — app mobile (Expo + React Native + NativeWind)",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:apk": "expo prebuild -p android && cd android && EXPO_PUBLIC_API_URL=https://32-195-76-205.nip.io/api ./gradlew assembleRelease && echo 'APK: android/app/build/outputs/apk/release/app-release.apk'",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-navigation/bottom-tabs": "^7.18.7",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "babel-preset-expo": "~57.0.0",
    "expo": "^57.0.26",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.53.0",
    "react-native": "0.86.3",
    "react-native-css-interop": "^0.2.6",
