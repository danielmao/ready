{
  "expo": {
    "name": "Ready",
    "slug": "ready",
    "version": "0.0.1",
    "orientation": "portrait",
    "scheme": "ready",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F172A"
      },
      "package": "com.danielmao.ready"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Ready accede a tus fotos para elegir la imagen de una prenda.",
          "cameraPermission": "Ready accede a la cámara para tomar la foto de una prenda."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#0F172A"
        }
      ]
    ]
  }
}
